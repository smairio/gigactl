#!/usr/bin/python3
"""Launcher for the packaged daemon: /usr/lib/gigactl is a private module
directory, so it has to be put on the path before the import."""
import sys

sys.path.insert(0, "/usr/lib/gigactl")

from gigactld.__main__ import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
