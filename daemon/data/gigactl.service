[Unit]
Description=GigaControl daemon (fan & keyboard control for Gigabyte G5/G6)
Documentation=https://github.com/smairio/gigactl
After=multi-user.target

[Service]
Type=dbus
BusName=io.github.smairio.gigactl
# The daemon picks its EC backend once, at startup, and prefers the ec_sys
# debugfs file because the kernel serialises each transaction there; the
# /dev/port fallback races the kernel's own EC driver. modules-load.d only fires
# at boot, so without this an install — or any start before that first boot —
# would come up on the fallback and stay there. Optional (the leading '-') so a
# kernel without the module still starts the daemon. write_support=1 comes from
# modprobe.d/gigactl.conf.
ExecStartPre=-/sbin/modprobe ec_sys
ExecStart=/usr/bin/gigactld
Restart=on-failure
RestartSec=2
# Failsafe: on any stop (including a crash), hand the fans back to the firmware
# curve so they can never be left frozen at a stale manual duty.
ExecStopPost=-/usr/bin/gigactld --restore-firmware

[Install]
WantedBy=multi-user.target
