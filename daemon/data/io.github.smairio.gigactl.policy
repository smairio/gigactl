<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>GigaControl</vendor>
  <vendor_url>https://github.com/smairio/gigactl</vendor_url>

  <action id="io.github.smairio.gigactl.control-fans">
    <description>Control laptop fan speed</description>
    <message>Authentication is required to control the fans</message>
    <defaults>
      <!-- Anyone physically logged in (active session) controls fans without a
           password, like screen brightness; inactive/remote sessions must
           authenticate as an administrator. -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.smairio.gigactl.control-keyboard">
    <description>Control the keyboard backlight</description>
    <message>Authentication is required to control the keyboard backlight</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
