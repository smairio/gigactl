#!/bin/bash
# gkbd — keyboard backlight control for Gigabyte G6 KF (Clevo-ODM single-zone RGB)
#
# Two modes, chosen by detect_mode (gigactl-cli-lib.sh):
#
#   daemon — the gigactl daemon owns io.github.smairio.gigactl, so it is the single
#     writer of the EC *and* the single owner of the saved backlight state
#     (/var/lib/gigactl/state.json, re-applied at boot and on resume). gkbd becomes
#     an unprivileged D-Bus client: no root, no ec_probe, no register writes — and
#     it deliberately does not touch its own store, because two stores for one
#     backlight is how a stale colour wins a race.
#   direct — the daemon is definitely not running, so gkbd drives the EC itself as
#     it always has, keeping its own store and holding the daemon's EC lock so
#     concurrent invocations serialise. When it *cannot tell*, it refuses rather
#     than guessing direct.
#
# Protocol (reverse-engineered 2026-07, cross-checked with tuxedo clevo-keyboard driver):
#   master enable : FDAT=0x0C FBUF=0x3F  doorbell FCMD=0xC4   (required once; before it, LED cmds are ignored)
#   master disable: FDAT=0x0C FBUF=0x20  doorbell FCMD=0xC4
#   color         : FDAT=0x03 FBUF=BLUE FBF1=RED FBF2=GREEN doorbell FCMD=0xCA   (EC wants B,R,G order!)
#   brightness    : FDAT=0x06 FBUF=level(0-255) doorbell FCMD=0xCA
# Mailbox ports: FCMD=0xF8 FDAT=0xF9 FBUF=0xFA FBF1=0xFB FBF2=0xFC (doorbell written last)
set -euo pipefail

TOOL=gkbd
# The shared plumbing (mode detection, D-Bus helpers, the EC lock): next to this
# script in a checkout, in the package's private directory once installed.
_LIB="$(dirname "$(readlink -f "$0")")/gigactl-cli-lib.sh"
[ -r "$_LIB" ] || _LIB=/usr/lib/gigactl/gigactl-cli-lib.sh
[ -r "$_LIB" ] || { echo "$TOOL: cannot find gigactl-cli-lib.sh" >&2; exit 1; }
. "$_LIB"

# Overridable only so cli/ can drive this as an ordinary user in a tmp directory.
EP=${GKBD_EC_PROBE:-/usr/bin/ec_probe}
STATE_DIR=${GKBD_STATE_DIR:-/var/lib/gkbd}
STATE=$STATE_DIR/state

MODEL=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
VENDOR=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)

model_check() {
  [ "${GKBD_UNSAFE:-0}" = "1" ] && return 0
  case "$VENDOR" in GIGABYTE*|Gigabyte*) ;; *)
    die "vendor '$VENDOR' unsupported — verified on Gigabyte G6 KF only. GKBD_UNSAFE=1 to override." ;;
  esac
  case "$MODEL" in
    "G6 KF") ;;
    G5*|G6*|G7*) echo "gkbd: note: '$MODEL' untested (verified on G6 KF)." >&2 ;;
    *) die "model '$MODEL' unsupported — verified on Gigabyte G6 KF only. GKBD_UNSAFE=1 to override." ;;
  esac
}

# --- daemon mode --------------------------------------------------------------

daemon_set_color() { call SetKeyboardColor uuu "$1" "$2" "$3"; }

# The daemon's API speaks percent; only the EC wants a 0-255 level.
daemon_set_brightness() { call SetKeyboardBrightness u "$1"; }

daemon_set_enabled() { call SetKeyboardEnabled b "$1"; }

daemon_status() {
  local out enabled r g b pct
  out=$(prop KeyboardState) || die "could not read the keyboard state from the daemon"
  read -r _type enabled r g b pct <<<"$out"
  [ -n "${pct:-}" ] || die "unexpected keyboard state from the daemon: $out"
  echo "daemon: R=$r G=$g B=$b brightness=${pct}% ($([ "$enabled" = true ] && echo on || echo off))"
}

daemon_apply() {
  # The legacy gkbd-restore.service and system-sleep hook used to call this. The
  # daemon re-applies its own saved state at boot and on resume, so there is
  # nothing to do — and doing it here would write a second, older value.
  echo "gkbd: the gigactl daemon restores the backlight itself; nothing to apply."
}

# --- direct mode --------------------------------------------------------------

send() { # $1=FDAT $2=FBUF [$3=FBF1 $4=FBF2] $5=doorbell
  "$EP" write 0xF9 "$1" >/dev/null
  "$EP" write 0xFA "$2" >/dev/null
  [ -n "${3:-}" ] && "$EP" write 0xFB "$3" >/dev/null
  [ -n "${4:-}" ] && "$EP" write 0xFC "$4" >/dev/null
  "$EP" write 0xF8 "${5:-0xCA}" >/dev/null
}

master_enable()  { send 0x0C 0x3F "" "" 0xC4; }
master_disable() { send 0x0C 0x20 "" "" 0xC4; }
set_color()  { send 0x03 "$3" "$1" "$2"; }  # args R G B -> EC order B,R,G
set_bright() { send 0x06 "$1"; }

save_state() { mkdir -p "$STATE_DIR"; echo "$1 $2" > "$STATE"; }

saved_brightness() { # the level to keep when only the colour changes
  local br=255
  [ -f "$STATE" ] && br=$(awk '{print $4}' "$STATE")
  echo "${br:-255}"
}

direct_set_color() { # $1=R $2=G $3=B
  local br; br=$(saved_brightness)
  lock_ec
  master_enable
  set_bright "$br"
  set_color "$1" "$2" "$3"
  save_state "$1 $2 $3" "$br"
}

direct_set_brightness() { # $1=percent
  local lvl=$(( $1 * 255 / 100 )) r g b
  lock_ec
  master_enable
  set_bright "$lvl"
  if [ -f "$STATE" ]; then
    read -r r g b _ < "$STATE"; save_state "$r $g $b" "$lvl"
  else
    save_state "0 0 200" "$lvl"
  fi
}

direct_set_enabled() { # $1=true|false
  lock_ec
  if [ "$1" = true ]; then
    master_enable
    if [ -f "$STATE" ]; then
      local r g b br
      read -r r g b br < "$STATE"
      set_bright "${br:-255}"
      set_color "$r" "$g" "$b"
    else
      set_bright 255
    fi
  else
    # The documented disable (PROTOCOL.md gotcha 1) — the same write the daemon
    # makes for SetKeyboardEnabled false. The old form, brightness 0, is silently
    # ignored by the EC before the first master enable of a boot.
    master_disable
  fi
}

direct_status() {
  if [ -f "$STATE" ]; then
    local r g b br
    read -r r g b br < "$STATE" 2>/dev/null || true
    echo "saved: R=$r G=$g B=$b brightness=$((${br:-255} * 100 / 255))%"
  else
    echo "no saved state (firmware default blue)"
  fi
}

direct_apply() {
  [ -f "$STATE" ] || { echo "gkbd: no saved state yet"; return 0; }
  local r g b br
  read -r r g b br < "$STATE"
  lock_ec
  master_enable
  set_bright "${br:-255}"
  set_color "$r" "$g" "$b"
}

# --- shared -------------------------------------------------------------------

named_color() {
  case "${1,,}" in
    red)     echo "255 0 0" ;;
    green)   echo "0 255 0" ;;
    blue)    echo "0 0 200" ;;   # firmware default blue
    white)   echo "255 255 255" ;;
    orange)  echo "255 80 0" ;;
    yellow)  echo "255 180 0" ;;
    cyan)    echo "0 255 255" ;;
    purple|violet) echo "160 0 255" ;;
    pink)    echo "255 0 120" ;;
    *) return 1 ;;
  esac
}

hex_color() { # RRGGBB or #RRGGBB
  local h="${1#\#}"
  [[ "$h" =~ ^[0-9a-fA-F]{6}$ ]] || return 1
  echo "$((16#${h:0:2})) $((16#${h:2:2})) $((16#${h:4:2}))"
}

usage() {
  cat <<'EOF'
gkbd — keyboard backlight control for Gigabyte G6 KF

Usage:
  gkbd <color>            named color: red green blue white orange yellow cyan purple pink
  gkbd <RRGGBB>           hex color, e.g. gkbd ff6600 or gkbd '#00ff88'
  gkbd brightness <0-100> backlight brightness percent
  gkbd off                backlight off
  gkbd on                 backlight on (restores saved color)
  gkbd status             show current state
  gkbd apply              re-apply saved state (legacy; the daemon does this itself)

With the gigactl daemon running, gkbd drives it over D-Bus, needs no root, and the
daemon is what remembers your colour across reboot and suspend. Without it, gkbd
writes the EC directly, keeps its own saved state and re-runs itself under sudo.
If it cannot tell whether the daemon is running, it refuses rather than guesses.
EOF
}

main() {
  case "${1:-}" in
    ""|-h|--help|help) usage; return 0 ;;
  esac

  detect_mode
  if [ "$MODE" = direct ]; then
    # Only the direct path needs the tool and the privileges to use it.
    [ -x "$EP" ] || die "ec_probe not found (nbfc-linux package), and the gigactl daemon is not running"
    if [ "$(id -u)" -ne 0 ]; then exec sudo "$0" "$@"; fi
  fi

  case "$1" in
    status) op status ;;
    apply) model_check; op apply ;;
    off) model_check; op set_enabled false; echo "Backlight off." ;;
    on) model_check; op set_enabled true; echo "Backlight on." ;;
    brightness)
      model_check
      local p="${2:-}"
      [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -le 100 ] || die "brightness needs 0-100"
      op set_brightness "$p"
      echo "Brightness ${p}%." ;;
    *)
      local rgb r g b
      rgb=$(named_color "$1") || rgb=$(hex_color "$1") || die "unknown color '$1' (try: gkbd help)"
      read -r r g b <<< "$rgb"
      model_check
      op set_color "$r" "$g" "$b"
      echo "Keyboard color set: R=$r G=$g B=$b" ;;
  esac
}

main "$@"
